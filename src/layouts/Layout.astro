---
// src/layouts/Layout.astro
import TopBanner from '../components/TopBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getRelativePath } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Turtle Transformation | 12-Month High Performance Leadership Coaching',
  description = 'Empowering senior executives, founders, and engineering leaders to shift from reactive firefighting to calm, intentional, high-leverage effectiveness.',
  ogImage = '/og-image.jpg',
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://schmidb.github.io');

// Default Organization JSON-LD Schema for AI agents & Search Engines
const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Turtle Transformation Limited',
  alternateName: 'The Authentic Leader Academy',
  url: 'https://turtletrafo.com',
  logo: 'https://turtletrafo.com/favicon.svg',
  email: 'info@turtletrafo.de',
  telephone: '+353872275723',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Drom Upper',
    addressLocality: 'Glenbeigh',
    addressRegion: 'Co. Kerry',
    postalCode: 'V93 F6X0',
    addressCountry: 'IE',
  },
  founders: [
    {
      '@type': 'Person',
      name: 'Miriam Schmidberger',
      jobTitle: 'Change Angel & Executive Performance Coach',
      knowsAbout: ['Leadership Development', 'Adaptability AQ', 'Emotional Regulation', 'Somatic Coaching'],
    },
    {
      '@type': 'Person',
      name: 'Dr. Markus Schmidberger',
      jobTitle: 'Enterprise Data & AI Consultant / Co-Founder',
      alumniOf: 'Technical University of Munich',
      knowsAbout: ['Enterprise AI Strategy', 'Data Engineering', 'Agile Team Scaling', 'Scrum'],
    },
  ],
};

const schemas = jsonLd 
  ? (Array.isArray(jsonLd) ? [defaultOrgSchema, ...jsonLd] : [defaultOrgSchema, jsonLd])
  : [defaultOrgSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={getRelativePath('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={getRelativePath('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={getRelativePath('/favicon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={getRelativePath('/sitemap.xml')} />
    <link rel="alternate" type="text/plain" href={getRelativePath('/llms.txt')} title="LLM and AI Agent Summary" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Turtle Transformation Limited" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <meta property="og:site_name" content="Turtle Transformation" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Structured Data JSON-LD for AI Agents & Search Engines -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Performance & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-serif {
        font-family: 'Source Serif 4', Georgia, serif;
      }
    </style>
  </head>
  <body class="bg-sand-50 text-turtle-950 flex flex-col min-h-screen selection:bg-turtle-200 selection:text-turtle-950 antialiased">
    <TopBanner />
    <Header currentPath={Astro.url.pathname} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
