---
// src/layouts/Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { getRelativePath } from '../utils/paths';
import {
  SITE_URL,
  SITE_NAME,
  WEBSITE_ID,
  ORG_ID,
  organizationSchema,
  websiteSchema,
  personSchemas,
  breadcrumbSchema,
} from '../utils/schema';
// Self-hosted fonts (no requests to Google Fonts, GDPR-friendly and faster).
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  /** Name of the current page for the breadcrumb trail (omit on the home page). */
  breadcrumb?: string;
  /** Page type for WebPage schema. */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  noindex?: boolean;
  /** Extra properties merged into the page's WebPage node (e.g. mainEntity). */
  webPageExtras?: Record<string, any>;
}

const {
  title = 'Turtle Transformation | 12-Month High Performance Leadership Coaching',
  description = 'Empowering senior executives, founders, and engineering leaders to shift from reactive firefighting to calm, intentional, high-leverage effectiveness.',
  ogImage = '/og-image.png',
  ogImageAlt = 'Turtle Transformation: executive coaching and AI & Data Advisory',
  jsonLd,
  breadcrumb,
  pageType = 'WebPage',
  noindex = false,
  webPageExtras = {},
} = Astro.props;

// Canonical URLs always point at the production domain, regardless of where the build is hosted
// (preview on github.io, local dev, ...). The base path is stripped and a trailing slash enforced,
// matching what GitHub Pages serves for directory-style pages.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let pagePath = Astro.url.pathname;
if (base && pagePath.startsWith(base)) pagePath = pagePath.slice(base.length);
if (!pagePath.startsWith('/')) pagePath = `/${pagePath}`;
if (!pagePath.endsWith('/') && !/\.[a-z0-9]+$/i.test(pagePath)) pagePath += '/';
const canonicalURL = new URL(pagePath, SITE_URL);
const ogImageURL = new URL(ogImage, SITE_URL);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': `${canonicalURL.href}#webpage`,
  url: canonicalURL.href,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  about: { '@id': ORG_ID },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageURL.href },
  ...webPageExtras,
};

const trail = breadcrumb
  ? [
      { name: 'Home', path: '/' },
      { name: breadcrumb, path: pagePath },
    ]
  : null;

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [
  organizationSchema(),
  websiteSchema(),
  ...personSchemas(),
  webPageSchema,
  ...(trail ? [breadcrumbSchema(trail)] : []),
  ...pageSchemas,
];

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0C1F1B" />
    <link rel="icon" type="image/svg+xml" href={getRelativePath('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={getRelativePath('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={getRelativePath('/favicon.png')} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href={getRelativePath('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" href={getRelativePath('/llms.txt')} title="LLM and AI Agent Summary" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Turtle Transformation Limited" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data JSON-LD for search engines and AI answer engines -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <style>
      body {
        font-family: 'Plus Jakarta Sans Variable', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="bg-sand-50 text-turtle-950 flex flex-col min-h-screen selection:bg-turtle-200 selection:text-turtle-950 antialiased">
    <Header currentPath={Astro.url.pathname} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <Analytics />
  </body>
</html>
