---
// src/components/Header.astro
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: '12-Month Coaching', href: '/' },
  { name: 'Our Journey & Story', href: '/about' },
  { name: 'Data & AI Consulting', href: '/data-ai-consulting' },
];
---

<header class="sticky top-0 z-40 bg-sand-50/90 backdrop-blur-md border-b border-sand-200/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Brand Identity -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none">
        <div class="w-10 h-10 rounded-xl bg-turtle-900 flex items-center justify-center text-turtle-200 border border-turtle-700 shadow-sm group-hover:scale-105 transition-transform duration-200">
          <svg class="w-6 h-6" viewBox="0 0 64 64" fill="none">
            <polygon points="32,18 42,24 42,36 32,42 22,36 22,24" fill="#23574B" stroke="#96C8BA" stroke-width="2" />
            <circle cx="32" cy="30" r="3" fill="#E2DDCB" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-lg tracking-tight font-semibold text-turtle-950 group-hover:text-turtle-700 transition-colors">
            Turtle Transformation
          </span>
          <span class="text-[10px] tracking-widest uppercase font-medium text-turtle-700/80">
            The Authentic Leader Academy
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors ${
                isActive
                  ? 'text-turtle-900 font-semibold border-b-2 border-turtle-600 pb-1'
                  : 'text-sand-700 hover:text-turtle-800'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="mailto:info@turtletrafo.de?subject=Discovery%20Call%20Request%20-%2012-Month%20Coaching"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-medium text-white bg-turtle-800 hover:bg-turtle-900 active:bg-turtle-950 shadow-sm hover:shadow transition-all focus:outline-none focus:ring-2 focus:ring-turtle-600 focus:ring-offset-2"
        >
          Book Discovery Call
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-md text-turtle-800 hover:text-turtle-950 hover:bg-sand-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-turtle-600"
          aria-expanded="false"
          aria-label="Toggle menu"
        >
          <svg class="h-6 w-6" id="menu-icon-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-opened" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="md:hidden hidden bg-sand-50 border-b border-sand-200" id="mobile-menu">
    <div class="px-4 pt-2 pb-4 space-y-2">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-3 py-2 rounded-md text-base font-medium ${
              isActive
                ? 'text-turtle-900 bg-turtle-100/60 font-semibold'
                : 'text-sand-800 hover:bg-sand-100 hover:text-turtle-900'
            }`}
          >
            {item.name}
          </a>
        );
      })}
      <div class="pt-3 border-t border-sand-200">
        <a
          href="mailto:info@turtletrafo.de?subject=Discovery%20Call%20Request%20-%2012-Month%20Coaching"
          class="w-full inline-flex items-center justify-center px-4 py-2.5 rounded-lg text-sm font-medium text-white bg-turtle-800 hover:bg-turtle-900"
        >
          Book Discovery Call
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconClosed = document.getElementById('menu-icon-closed');
  const iconOpened = document.getElementById('menu-icon-opened');

  if (btn && menu && iconClosed && iconOpened) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      iconClosed.classList.toggle('hidden');
      iconOpened.classList.toggle('hidden');
    });
  }
</script>
