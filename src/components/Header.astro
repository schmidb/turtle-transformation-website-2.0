---
// src/components/Header.astro
import { getRelativePath } from '../utils/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const homeHref = getRelativePath('/');
const aboutHref = getRelativePath('/about');
const consultingHref = getRelativePath('/data-ai-consulting');

const navItems = [
  { name: '12-Month Coaching', href: homeHref },
  { name: 'Our Journey', href: aboutHref },
  { name: 'Data & AI Advisory', href: consultingHref },
];
---

<header class="sticky top-0 z-40 bg-sand-50/95 backdrop-blur-md border-b border-sand-200/60 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={homeHref} class="flex items-center gap-3 group focus:outline-none">
        <div class="w-9 h-9 rounded-xl bg-turtle-900 flex items-center justify-center text-turtle-200 shadow-sm group-hover:scale-105 transition-transform duration-200">
          <svg class="w-5 h-5" width="20" height="20" viewBox="0 0 64 64" fill="none">
            <polygon points="32,18 42,24 42,36 32,42 22,36 22,24" fill="#23574B" stroke="#96C8BA" stroke-width="2" />
            <circle cx="32" cy="30" r="3" fill="#E2DDCB" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-lg tracking-tight font-semibold text-turtle-950 group-hover:text-turtle-800 transition-colors leading-tight">
            Turtle Transformation
          </span>
          <span class="text-[10px] tracking-widest uppercase font-medium text-sand-600">
            The Authentic Leader Academy
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== homeHref && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`text-sm tracking-normal transition-colors py-1 ${
                isActive
                  ? 'text-turtle-950 font-semibold border-b border-turtle-800'
                  : 'text-sand-700 hover:text-turtle-950 font-medium'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA Action -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="mailto:info@turtletrafo.de?subject=Discovery%20Call%20Request%20-%2012-Month%20Coaching"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs font-semibold uppercase tracking-wider text-white bg-turtle-900 hover:bg-turtle-800 active:bg-turtle-950 shadow-sm hover:shadow transition-all"
        >
          Book Discovery Call
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-turtle-900 hover:bg-sand-100 focus:outline-none"
          aria-expanded="false"
          aria-label="Toggle menu"
        >
          <svg class="h-6 w-6" width="24" height="24" id="menu-icon-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-6 w-6 hidden" width="24" height="24" id="menu-icon-opened" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="md:hidden hidden bg-sand-50 border-b border-sand-200/80" id="mobile-menu">
    <div class="px-5 pt-3 pb-6 space-y-3">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== homeHref && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-3 py-2 rounded-lg text-base ${
              isActive
                ? 'text-turtle-950 bg-sand-200/60 font-semibold'
                : 'text-sand-700 hover:text-turtle-950'
            }`}
          >
            {item.name}
          </a>
        );
      })}
      <div class="pt-4 border-t border-sand-200/80">
        <a
          href="mailto:info@turtletrafo.de?subject=Discovery%20Call%20Request%20-%2012-Month%20Coaching"
          class="w-full inline-flex items-center justify-center px-4 py-3 rounded-full text-xs uppercase tracking-wider font-semibold text-white bg-turtle-900 hover:bg-turtle-800"
        >
          Book Discovery Call
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconClosed = document.getElementById('menu-icon-closed');
  const iconOpened = document.getElementById('menu-icon-opened');

  if (btn && menu && iconClosed && iconOpened) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      iconClosed.classList.toggle('hidden');
      iconOpened.classList.toggle('hidden');
    });
  }
</script>
