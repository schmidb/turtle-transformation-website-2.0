---
// Plain outbound link to a LinkedIn profile. No script or tracker is loaded.
interface Props {
  href: string;
  name: string;
}

const { href, name } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} on LinkedIn (opens in a new tab)`}
  class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-full border border-turtle-800 px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-turtle-900 transition-colors hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-turtle-950"
>
  <svg class="h-4 w-4" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
  </svg>
  <span>LinkedIn</span>
</a>
