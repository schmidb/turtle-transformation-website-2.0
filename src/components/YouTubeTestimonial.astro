---
interface Props {
  name: string;
  videoId: string;
}

const { name, videoId } = Astro.props;
---

<div class="video-testimonial border-t-2 border-turtle-800 bg-sand-50 p-6" data-youtube-testimonial data-video-id={videoId} data-name={name}>
  <div class="flex aspect-video items-center justify-center border border-sand-200 bg-turtle-950 p-6 text-center">
    <div>
      <p class="text-sm font-semibold text-white">{name}</p>
      <p class="mt-1 text-xs text-turtle-200">Video testimonial</p>
    </div>
  </div>
  <div class="mt-4">
    <p class="text-sm font-semibold text-turtle-950">{name}</p>
    <p class="mt-1 text-sm text-sand-700">Video testimonial</p>
  </div>
  <button type="button" class="mt-5 inline-flex min-h-[48px] w-full items-center justify-center rounded-full bg-turtle-900 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-turtle-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-turtle-950" data-youtube-play aria-label={`Play ${name}'s video testimonial on YouTube`}>
    Play testimonial on YouTube
  </button>
  <p class="mt-3 text-xs leading-relaxed text-sand-600">Playing this video creates a connection to YouTube and sends data to YouTube.</p>
</div>

<script>
  document.querySelectorAll('[data-youtube-testimonial]').forEach((container) => {
    const button = container.querySelector('[data-youtube-play]');

    button?.addEventListener('click', () => {
      const videoId = container.dataset.videoId;
      const name = container.dataset.name;
      if (!videoId || !name) return;

      const iframe = document.createElement('iframe');
      iframe.className = 'aspect-video w-full border-0';
      iframe.title = `${name} video testimonial`;
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      container.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
