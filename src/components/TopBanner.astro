---
// src/components/TopBanner.astro
import { getRelativePath } from '../utils/paths';
---

<div class="bg-turtle-950 text-sand-200 border-b border-turtle-900/60 px-4 py-2 sm:px-6">
  <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between text-xs gap-2">
    <div class="flex items-center gap-2">
      <span class="text-[11px] uppercase tracking-wider font-semibold text-turtle-300">
        Enterprise Advisory
      </span>
      <span class="text-sand-400 hidden sm:inline">•</span>
      <span class="text-sand-300 font-normal">
        Looking for strategic Data & AI leadership?
      </span>
    </div>
    
    <div class="flex items-center gap-3">
      <span class="text-sand-400 hidden lg:inline">
        Led by Miriam (Industry AI Advisor, MTU Kerry) & Dr. Markus Schmidberger
      </span>
      <a 
        href={getRelativePath('/data-ai-consulting')} 
        class="inline-flex items-center gap-1 text-turtle-200 hover:text-white font-medium underline underline-offset-4 decoration-turtle-600/60 transition-colors"
      >
        <span>Explore Data & AI Practice</span>
        <svg class="w-3.5 h-3.5" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor">
          <path d="M6 3L11 8L6 13" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>

