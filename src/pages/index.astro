---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getRelativePath } from '../utils/paths';

const coachingServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '12-Month High Performance Executive Coaching Program',
  provider: {
    '@type': 'Person',
    name: 'Miriam Schmidberger',
    jobTitle: 'Change Angel & Executive Performance Coach',
  },
  description: 'A tailored 12-month coaching partnership for senior executives and founders to transition from reactive firefighting to calm, grounded, high-leverage effectiveness.',
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Coaching Packages',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Core 12-Month Program',
        price: '4700',
        priceCurrency: 'EUR',
        description: 'Includes 12x 60-min strategic sessions, 12x 30-min practical sessions, and two diagnostic assessments.',
      },
      {
        '@type': 'Offer',
        name: 'Executive Retainer Tier (with Asynchronous WhatsApp Support)',
        price: '8060',
        priceCurrency: 'EUR',
        description: 'Core program plus €280/month for dedicated Mon-Thu real-time WhatsApp audio/text advisory.',
      },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much time does this program demand per week?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The program requires one 60-minute strategic session and one 30-minute practical implementation session each month. Rather than adding to your workload, the Pareto 80/20 framework routinely frees up 5 to 10 hours of wasted operational firefighting each week.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can my employer fund or sponsor my coaching?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Many clients have their 12-month program covered via corporate leadership training or executive development budgets. Official VAT invoices are issued by Turtle Transformation Limited (Ireland).',
      },
    },
    {
      '@type': 'Question',
      name: 'What occurs during the initial Discovery Call?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The 30-minute discovery call is a confidential, zero-pressure diagnostic conversation conducted over video. We explore your leadership stressors, team dynamics, and evaluate mutual fit.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are sessions conducted virtually or in person?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Delivery is hybrid. The majority of sessions take place over private video conferencing worldwide. Clients are also welcome to arrange in-person VIP immersion days in County Kerry, Ireland.',
      },
    },
  ],
};
---

<Layout 
  title="12-Month Executive Coaching with Miriam Schmidberger | Turtle Transformation"
  description="A bespoke 12-month leadership coaching program helping senior executives and founders transition from reactive overwork to calm, intentional effectiveness."
  jsonLd={[coachingServiceSchema, faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-32 bg-gradient-to-b from-sand-100/50 via-sand-50 to-sand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Pre-header Label -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sand-200/70 text-turtle-900 text-xs font-semibold tracking-wider uppercase mb-8">
        <span>The Authentic Leader Academy</span>
        <span>•</span>
        <span>12-Month Executive Partnership</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-turtle-950 leading-[1.15] text-balance mb-6">
        Shift from Reactive Firefighting to <span class="italic font-normal text-turtle-800">Calm, High-Impact</span> Leadership.
      </h1>

      <!-- Subheadline -->
      <p class="max-w-2xl mx-auto text-base sm:text-lg lg:text-xl text-sand-700 leading-relaxed text-balance mb-10 font-normal">
        A bespoke 12-month coaching partnership with <strong class="text-turtle-950 font-semibold">Miriam Schmidberger</strong> for senior directors, C-suite executives, and high-growth founders. Decouple high-stakes pressure from physiological panic, establish unshakeable boundaries, and achieve effortless strategic leverage.
      </p>

      <!-- Primary Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-8">
        <a 
          href="mailto:info@turtletrafo.de?subject=12-Month%20Coaching%20Application%20-%20Discovery%20Call" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-sm font-semibold text-white bg-turtle-900 hover:bg-turtle-800 active:bg-turtle-950 shadow-sm hover:shadow transition-all min-h-[50px]"
        >
          <svg class="w-4 h-4 text-turtle-200" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Apply via Email: info@turtletrafo.de</span>
        </a>
        <a 
          href="#program" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold text-turtle-900 bg-white hover:bg-sand-100 border border-sand-300 transition-all min-h-[50px]"
        >
          Explore Framework
        </a>
      </div>

      <!-- Quick Contact Microcopy -->
      <p class="text-xs text-sand-600 mb-16">
        Direct confidential executive contact: <a href="mailto:info@turtletrafo.de" class="text-turtle-900 underline underline-offset-4 decoration-sand-400 font-medium">info@turtletrafo.de</a>
      </p>

      <!-- Clean Metrics Bar -->
      <div class="pt-10 border-t border-sand-200/80 grid grid-cols-2 md:grid-cols-4 gap-8 text-center sm:text-left">
        <div>
          <div class="font-serif text-3xl font-normal text-turtle-950">20+ Years</div>
          <div class="text-xs uppercase tracking-wider text-sand-600 font-medium mt-1">Leadership Mastery</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-normal text-turtle-950">AQai</div>
          <div class="text-xs uppercase tracking-wider text-sand-600 font-medium mt-1">Certified Adaptability</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-normal text-turtle-950">Greator '24</div>
          <div class="text-xs uppercase tracking-wider text-sand-600 font-medium mt-1">Keynote Speaker</div>
        </div>
        <div>
          <div class="font-serif text-3xl font-normal text-turtle-950">Global</div>
          <div class="text-xs uppercase tracking-wider text-sand-600 font-medium mt-1">Virtual & Kerry, IE</div>
        </div>
      </div>

    </div>
  </section>

  <!-- The Executive Shift Section -->
  <section class="py-24 bg-white border-y border-sand-200/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">The Leadership Shift</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-turtle-950 mt-2 mb-4 tracking-tight">
          Why Traditional Executive Coaching Fails Under Pressure
        </h2>
        <p class="text-sand-700 leading-relaxed text-sm sm:text-base">
          Most coaching treats leadership as an intellectual exercise in calendars and KPIs. But when high-stakes organizational crises strike, cognitive frameworks collapse. Real leadership transformation begins with nervous system regulation, emotional digestion, and deep self-trust.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        
        <!-- The Overworked State -->
        <div class="p-8 sm:p-10 rounded-2xl bg-sand-50/70 border border-sand-200/80 shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-sand-600 mb-3">
              The Reactive Status Quo
            </div>
            <h3 class="font-serif text-2xl font-normal text-turtle-950 mb-6">
              Managing from Overload & Fear
            </h3>
            <ul class="space-y-4 text-sm text-sand-700">
              <li class="flex items-start gap-3">
                <span class="text-sand-400 mt-1 text-xs">•</span>
                <span><strong>Operational Firefighting:</strong> Consumed by urgent escalations and systemic overtime, leaving zero space for strategic foresight.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-sand-400 mt-1 text-xs">•</span>
                <span><strong>Physiological Shutdown:</strong> Live production crises trigger fight-or-flight panic, cognitive tunnel vision, and insomnia.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-sand-400 mt-1 text-xs">•</span>
                <span><strong>Porous Boundaries:</strong> Sacrificing family presence, health, and rest due to unwritten corporate expectations.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-sand-400 mt-1 text-xs">•</span>
                <span><strong>Micromanagement Bottlenecks:</strong> Fear of mistakes creates team dependency, burnout, and unnecessary turnover.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- The Grounded State -->
        <div class="p-8 sm:p-10 rounded-2xl bg-turtle-950 text-sand-100 border border-turtle-900 shadow-md flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-turtle-300 mb-3">
              The 12-Month Transformation
            </div>
            <h3 class="font-serif text-2xl font-normal text-white mb-6">
              The Grounded Authentic Leader
            </h3>
            <ul class="space-y-4 text-sm text-sand-200">
              <li class="flex items-start gap-3">
                <span class="text-emerald-400 mt-1 text-xs">✓</span>
                <span><strong>Pareto 80/20 Leverage:</strong> Focusing relentlessly on the 20% of strategic levers that generate 80% of enterprise outcomes.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-400 mt-1 text-xs">✓</span>
                <span><strong>Emotional Regulation:</strong> Active emotional digestion replacing panic with calm, anchored executive composure.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-400 mt-1 text-xs">✓</span>
                <span><strong>Contractual Agency:</strong> Unshakeable boundaries that protect personal stamina while earning deep organizational respect.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-emerald-400 mt-1 text-xs">✓</span>
                <span><strong>Autonomous Teams:</strong> Psychological safety that empowers teams to run independently without fear of failure.</span>
              </li>
            </ul>
          </div>
        </div>

      </div>

      <!-- Core Principle Callout -->
      <div class="mt-16 text-center max-w-xl mx-auto">
        <blockquote class="font-serif italic text-lg sm:text-xl text-turtle-900 leading-relaxed">
          &ldquo;Slow is smooth, and smooth is fast. When you cultivate inner stillness, your speed of high-stakes decision making accelerates dramatically.&rdquo;
        </blockquote>
      </div>

    </div>
  </section>

  <!-- Program Architecture Section -->
  <section id="program" class="py-24 bg-sand-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mx-auto text-center mb-16">
        <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">The Curriculum</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-turtle-950 mt-2 mb-4 tracking-tight">
          The 12-Month Executive Architecture
        </h2>
        <p class="text-sand-700 leading-relaxed text-sm sm:text-base">
          A phased, systematic methodology that transforms both your internal neuro-emotional state and your outward leadership impact.
        </p>
      </div>

      <!-- Preparatory Phase Baseline Card -->
      <div class="mb-10 p-8 sm:p-10 rounded-2xl bg-white border border-sand-200/80 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-sand-200/60">
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-turtle-700">Diagnostic Baseline • Weeks 1 – 2</span>
            <h3 class="font-serif text-2xl font-normal text-turtle-950 mt-1">Preparatory Diagnostics Before Kickoff</h3>
            <p class="text-xs text-sand-600 mt-1">Establishing baseline metrics, blind spots, and growth tracks.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <div class="p-6 rounded-xl bg-sand-50/60 border border-sand-200/60">
            <h4 class="font-serif text-base font-semibold text-turtle-950 mb-2">
              1. Adaptability Assessment (AQai)
            </h4>
            <p class="text-xs text-sand-700 leading-relaxed">
              Measures your Adaptability Quotient (AQ)—the vital leadership metric for navigating unscripted volatility, tech disruption, and high-frequency change without cognitive exhaustion.
            </p>
          </div>

          <div class="p-6 rounded-xl bg-sand-50/60 border border-sand-200/60">
            <h4 class="font-serif text-base font-semibold text-turtle-950 mb-2">
              2. Five-Mountain Leadership Assessment
            </h4>
            <p class="text-xs text-sand-700 leading-relaxed">
              Holistic audit evaluating five vital dimensions: Physical resilience, Mental clarity, Emotional agility, Strategic intuition, and Integrated execution (Kokoro / warrior heart).
            </p>
          </div>
        </div>
      </div>

      <!-- Four Core Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        
        <!-- Pillar 1 -->
        <div class="p-8 sm:p-10 rounded-2xl bg-white border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">01</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Cognitive Restructuring & Habits
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed mb-4">
            Identify and dismantle subconscious drivers, habitual procrastination loops, and automatic reaction patterns under high corporate pressure.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Dismantling childhood-inherited compliance drivers</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Replacing over-functioning with deliberate strategic prioritization</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 2 -->
        <div class="p-8 sm:p-10 rounded-2xl bg-white border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">02</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Somatic Stress Regulation
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed mb-4">
            Decouple acute business triggers from physiological stress responses (cortisol/adrenaline spikes) using Parts Work, IFS principles, and embodied somatic tools.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Processing panic and despair safely without shutting down</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Reclaiming cognitive clarity in high-stakes board or investor meetings</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 3 -->
        <div class="p-8 sm:p-10 rounded-2xl bg-white border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">03</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            High-Impact Dialogue & Boundaries
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed mb-4">
            Master non-violent communication (NVC) and structured boundary negotiation to eliminate passive-aggressive friction and navigate stakeholder politics.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Mastering the 3 Structured Reflection Questions for boundary defense</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Speaking truth without defensive withholding or fear of backlash</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 4 -->
        <div class="p-8 sm:p-10 rounded-2xl bg-white border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">04</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Team Performance & Safety
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed mb-4">
            Transition from control-oriented management to cultivating an autonomous, high-retention engineering/business culture through enhanced empathy and trust.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Non-punitive mistake analysis that accelerates team velocity</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Proven track record: Drastic reduction in employee sick days & turnover</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Program Delivery & Cadence Details -->
      <div class="p-8 sm:p-10 rounded-2xl bg-turtle-950 text-sand-100 border border-turtle-900">
        <h3 class="font-serif text-2xl font-normal text-white mb-6 text-center">
          Program Delivery & Logistics
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
          
          <div class="space-y-1.5">
            <div class="text-turtle-300 font-semibold text-xs uppercase tracking-wider">Duration</div>
            <div class="text-lg font-normal text-white font-serif">12 Full Months</div>
            <p class="text-xs text-sand-300 leading-relaxed pt-1">
              Deep, sustainable habit integration ensuring complete leadership self-sufficiency and independence by month 12.
            </p>
          </div>

          <div class="space-y-1.5">
            <div class="text-turtle-300 font-semibold text-xs uppercase tracking-wider">Monthly Cadence</div>
            <div class="text-lg font-normal text-white font-serif">2 Dedicated Sessions</div>
            <p class="text-xs text-sand-300 leading-relaxed pt-1">
              1x 60-min Strategic Deep-Dive plus 1x 30-min Practical Operational Implementation session each month.
            </p>
          </div>

          <div class="space-y-1.5">
            <div class="text-turtle-300 font-semibold text-xs uppercase tracking-wider">Delivery Format</div>
            <div class="text-lg font-normal text-white font-serif">Hybrid Worldwide</div>
            <p class="text-xs text-sand-300 leading-relaxed pt-1">
              Delivered via private video conferencing worldwide, with optional VIP in-person immersion in County Kerry, Ireland.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Investment & Commitment Section -->
  <section class="py-24 bg-white border-b border-sand-200/60">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-16">
        <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">Transparent Pricing</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-turtle-950 mt-2 mb-3 tracking-tight">
          Investment & Partnership Options
        </h2>
        <p class="text-sand-700 text-sm sm:text-base">
          Structured for tangible personal ROI, sustainable energy, and organizational velocity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        <!-- Base Package -->
        <div class="p-8 sm:p-10 rounded-2xl bg-sand-50/70 border border-sand-200/80 flex flex-col justify-between">
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-sand-600">Core Executive Partnership</div>
            <h3 class="font-serif text-2xl font-normal text-turtle-950 mt-1 mb-2">12-Month Coaching</h3>
            <div class="my-4">
              <span class="text-4xl font-normal text-turtle-950 font-serif">€4,700</span>
              <span class="text-sand-600 text-sm"> / full year</span>
            </div>
            <p class="text-xs text-sand-600 mb-6">
              Payable in two installments of €2,350 with a formal 6-month progress audit.
            </p>
            <ul class="space-y-3 text-xs sm:text-sm text-sand-700 border-t border-sand-200/60 pt-6">
              <li class="flex items-center gap-2">
                <span class="text-turtle-700 font-bold">✓</span>
                <span>Both Baseline Assessments (AQai & Five-Mountain)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-700 font-bold">✓</span>
                <span>12x 60-min Strategic Coaching Sessions</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-700 font-bold">✓</span>
                <span>12x 30-min Practical Application Sessions</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-700 font-bold">✓</span>
                <span>Custom exercises, somatic practices & reading</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-700 font-bold">✓</span>
                <span>Corporate VAT invoices issued for employer sponsorship</span>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-sand-200/60">
            <a 
              href="mailto:info@turtletrafo.de?subject=Application%20-%2012-Month%20Coaching%20Program%20(Core)" 
              class="w-full inline-flex items-center justify-center px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-semibold text-turtle-900 bg-sand-200 hover:bg-sand-300 transition-colors min-h-[46px]"
            >
              Apply via info@turtletrafo.de
            </a>
          </div>
        </div>

        <!-- Premium Package with Asynchronous WhatsApp -->
        <div class="p-8 sm:p-10 rounded-2xl bg-turtle-950 text-sand-100 border border-turtle-900 flex flex-col justify-between relative shadow-md">
          <div>
            <div class="text-xs uppercase tracking-wider font-semibold text-turtle-300">Executive Retainer + Real-Time Access</div>
            <h3 class="font-serif text-2xl font-normal text-white mt-1 mb-2">Continuous Support Tier</h3>
            <div class="my-4">
              <span class="text-4xl font-normal text-white font-serif">€4,700</span>
              <span class="text-sand-300 text-sm"> + €280/mo retainer</span>
            </div>
            <p class="text-xs text-sand-300 mb-6">
              Includes full core program plus real-time between-session support for immediate crisis feedback.
            </p>
            <ul class="space-y-3 text-xs sm:text-sm text-sand-200 border-t border-turtle-900 pt-6">
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Everything in Core Program</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Dedicated WhatsApp Voice/Text Access</strong> (Mon–Thu)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Same-day tactical feedback for board meetings & crisis disputes</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Weekly habit and somatic accountability check-ins</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Priority scheduling for urgent calendar realignments</span>
              </li>
            </ul>
          </div>
