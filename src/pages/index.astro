---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import YouTubeTestimonial from '../components/YouTubeTestimonial.astro';
import { getRelativePath } from '../utils/paths';
import { faqPageSchema, ORG_ID, MIRIAM_ID, SITE_URL } from '../utils/schema';
import type { FaqItem } from '../utils/schema';

const coachingServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '12-Month Executive Coaching',
  '@id': `${SITE_URL}/#coaching-program`,
  url: `${SITE_URL}/`,
  serviceType: 'Executive Coaching',
  provider: [{ '@id': MIRIAM_ID }, { '@id': ORG_ID }],
  description: 'A 12-month executive coaching program for senior leaders and founders.',
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Executive Coaching Offers',
    itemListElement: [
      {
        '@type': 'Offer',
        name: '12-Month Executive Coaching Program',
        price: '5400',
        priceCurrency: 'EUR',
        description: 'Twelve monthly 60-minute coaching sessions, twelve 30-minute practical application and training sessions, and two baseline assessments. Payable in two installments of €2,700.',
      },
      {
        '@type': 'Offer',
        name: 'Asynchronous Tuesday and Thursday Support',
        price: '280',
        priceCurrency: 'EUR',
        description: 'Optional asynchronous support, available Tuesday and Thursday, billed monthly.',
      },
      {
        '@type': 'Offer',
        name: 'Additional Individual Session',
        price: '450',
        priceCurrency: 'EUR',
        description: 'Optional additional individual sessions, billed per hour.',
      },
    ],
  },
};

const faqItems: FaqItem[] = [
  {
    question: 'What does the 12-month executive coaching program cost?',
    answer: 'The core 12-month program costs €5,400, payable in two installments of €2,700.',
  },
  {
    question: 'What is included?',
    answer: 'The program includes the AQai Adaptability Assessment, the Five-Mountain Leadership Assessment, one 60-minute coaching session each month, and one 30-minute practical application and training session each month.',
  },
  {
    question: 'Is support available between sessions?',
    answer: 'Optional asynchronous support is available on Tuesday and Thursday for €280 per month.',
  },
  {
    question: 'Can I book additional time?',
    answer: 'Additional individual sessions are available at €450 per hour.',
  },
  {
    question: 'Who is the program for?',
    answer: 'The program is for senior leaders and founders who want dedicated space to examine their leadership practice and priorities over 12 months.',
  },
  {
    question: 'How do I request a conversation?',
    answer: 'Email info@turtletrafo.com to request a confidential conversation. You will receive a response within 48 hours.',
  },
];

const faqSchema = faqPageSchema(faqItems);
---

<Layout
  title="12-Month Executive Coaching | Turtle Transformation"
  description="A 12-month executive coaching program for senior leaders and founders. €5,400 in two €2,700 installments."
  jsonLd={[coachingServiceSchema, faqSchema]}
>
  <section class="relative overflow-hidden bg-sand-50 pt-16 pb-16 sm:pt-24 sm:pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-700 mb-5">The Authentic Leader Academy</p>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl leading-[1.08] text-turtle-950 tracking-tight">A year to lead with more clarity.</h1>
        <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-sand-700">A focused 12-month coaching partnership with Miriam Schmidberger for senior leaders and founders. Make room for thoughtful decisions, clear boundaries, and leadership practices that fit the work in front of you.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
          <a href="mailto:info@turtletrafo.com?subject=Request%20a%20confidential%20conversation" class="inline-flex min-h-[48px] w-full sm:w-auto items-center justify-center rounded-full bg-turtle-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-turtle-800">Request a confidential conversation</a>
          <a href="#program" class="inline-flex min-h-[48px] w-full sm:w-auto items-center justify-center rounded-full border border-sand-300 px-6 py-3 text-sm font-semibold text-turtle-900 transition-colors hover:bg-sand-100">See the program</a>
        </div>
        <p class="mt-4 text-sm text-sand-600">Email <a href="mailto:info@turtletrafo.com" class="font-medium text-turtle-900 underline underline-offset-4">info@turtletrafo.com</a>. A confidential response within 48 hours.</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="evidence-title" class="border-y border-sand-200 bg-white py-14 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-8">
        <div>
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-700">Client evidence</p>
          <h2 id="evidence-title" class="mt-2 font-serif text-3xl text-turtle-950">What clients share</h2>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-sand-700">Short, client-approved reflections on the coaching experience.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <article class="border-t-2 border-turtle-800 bg-sand-50 p-6">
          <p class="text-sm font-semibold text-turtle-950">Alexandra</p>
          <p class="mt-3 text-sm leading-relaxed text-sand-700">In her client-approved video testimonial, Alexandra reflects on her coaching experience with Miriam.</p>
          <p class="mt-5 text-sm font-medium text-turtle-800" aria-label="Rated 5 out of 5">5/5</p>
        </article>
        <article class="border-t-2 border-turtle-800 bg-sand-50 p-6">
          <p class="text-sm font-semibold text-turtle-950">Anna</p>
          <p class="mt-3 text-sm leading-relaxed text-sand-700">Written testimonial about Miriam's steady guidance while retaining ownership of her own direction.</p>
          <p class="mt-5 text-sm font-medium text-turtle-800" aria-label="Rated 5 out of 5">5/5</p>
        </article>
        <article class="border-t-2 border-turtle-800 bg-sand-50 p-6">
          <p class="text-sm font-semibold text-turtle-950">Torsten Niedermeyer</p>
          <p class="mt-3 text-sm leading-relaxed text-sand-700">In his client-approved video testimonial, Torsten Niedermeyer reflects on his coaching experience with Miriam.</p>
          <p class="mt-5 text-sm font-medium text-turtle-800" aria-label="Rated 4 out of 5">4/5</p>
        </article>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <YouTubeTestimonial name="Thorsten" videoId="cu2TnvjpiFE" />
        <YouTubeTestimonial name="Ali" videoId="Kcp4eAiiAhU" />
      </div>
    </div>
  </section>

  <section id="program" class="bg-sand-50 py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-700">The program</p>
          <h2 class="mt-2 font-serif text-3xl sm:text-4xl text-turtle-950">A practical monthly rhythm.</h2>
          <p class="mt-5 text-sm sm:text-base leading-relaxed text-sand-700">The work begins with two baseline assessments, then creates a regular space to consider priorities, communication, habits, and the situations that need your attention.</p>
        </div>
        <div class="lg:col-span-7 grid gap-4 sm:grid-cols-2">
          <div class="border border-sand-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-turtle-700">Starting point</p>
            <h3 class="mt-2 font-serif text-xl text-turtle-950">Two baseline assessments</h3>
            <p class="mt-3 text-sm leading-relaxed text-sand-700">AQai Adaptability Assessment and Five-Mountain Leadership Assessment.</p>
          </div>
          <div class="border border-sand-200 bg-white p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-turtle-700">Monthly cadence</p>
            <h3 class="mt-2 font-serif text-xl text-turtle-950">90 minutes together</h3>
            <p class="mt-3 text-sm leading-relaxed text-sand-700">One 60-minute coaching session plus one 30-minute practical application and training session.</p>
          </div>
          <div class="border border-sand-200 bg-white p-6 sm:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-turtle-700">Working map</p>
            <div class="mt-3 grid gap-3 sm:grid-cols-3 text-sm leading-relaxed text-sand-700">
              <p><strong class="text-turtle-950">Notice.</strong> Identify patterns, pressures, and priorities.</p>
              <p><strong class="text-turtle-950">Practice.</strong> Apply reflection, communication, and regulation tools to current work.</p>
              <p><strong class="text-turtle-950">Review.</strong> Return to what is changing and choose the next useful action.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-4">
          <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-700">Investment</p>
          <h2 class="mt-2 font-serif text-3xl sm:text-4xl text-turtle-950">Clear pricing.</h2>
          <p class="mt-4 text-sm leading-relaxed text-sand-700">The core program covers a full year of structured coaching. Optional support and additional sessions are priced separately.</p>
        </div>
        <div class="lg:col-span-8 grid gap-4 md:grid-cols-3">
          <div class="border border-sand-200 p-6">
            <p class="text-xs uppercase tracking-wider font-semibold text-turtle-700">Core program</p>
            <p class="mt-3 font-serif text-3xl text-turtle-950">€5,400</p>
            <p class="mt-2 text-sm leading-relaxed text-sand-700">Two installments of €2,700.</p>
          </div>
          <div class="border border-sand-200 p-6">
            <p class="text-xs uppercase tracking-wider font-semibold text-turtle-700">Optional support</p>
            <p class="mt-3 font-serif text-3xl text-turtle-950">€280<span class="text-base">/month</span></p>
            <p class="mt-2 text-sm leading-relaxed text-sand-700">Asynchronous support on Tuesday and Thursday.</p>
          </div>
          <div class="border border-sand-200 p-6">
            <p class="text-xs uppercase tracking-wider font-semibold text-turtle-700">Additional time</p>
            <p class="mt-3 font-serif text-3xl text-turtle-950">€450<span class="text-base">/hour</span></p>
            <p class="mt-2 text-sm leading-relaxed text-sand-700">Additional individual sessions when needed.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-sand-200 bg-sand-50 py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="md:col-span-8">
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-700">Also available</p>
        <h2 class="mt-2 font-serif text-3xl text-turtle-950">Data & AI Advisory</h2>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-sand-700">For organisations working through data, AI, and adoption questions, Turtle Transformation also offers a separate advisory practice led by Miriam and Dr. Markus Schmidberger.</p>
      </div>
      <div class="md:col-span-4 md:text-right"><a href={getRelativePath('/data-ai-consulting')} class="inline-flex min-h-[48px] items-center justify-center rounded-full border border-turtle-800 px-6 py-3 text-sm font-semibold text-turtle-900 hover:bg-white">Explore Data & AI Advisory</a></div>
    </div>
  </section>

  <Faq items={faqItems} intro="Program details and contact information." />

  <section class="bg-turtle-950 py-16 sm:py-24 text-sand-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs uppercase tracking-[0.18em] font-semibold text-turtle-300">Executive coaching</p>
      <h2 class="mt-3 font-serif text-3xl sm:text-4xl text-white">Start with a confidential conversation.</h2>
      <p class="mt-5 text-sm sm:text-base leading-relaxed text-sand-300">Share a little about the leadership situation you want to work on. Email is the first step, and you will receive a response within 48 hours.</p>
      <a href="mailto:info@turtletrafo.com?subject=Request%20a%20confidential%20conversation" class="mt-8 inline-flex min-h-[48px] w-full sm:w-auto items-center justify-center rounded-full bg-sand-200 px-6 py-3 text-sm font-semibold text-turtle-950 hover:bg-white">Request a confidential conversation</a>
      <p class="mt-5 text-sm text-turtle-300"><a href="mailto:info@turtletrafo.com" class="underline underline-offset-4">info@turtletrafo.com</a> · Response within 48 hours</p>
    </div>
  </section>
</Layout>
