---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getRelativePath } from '../utils/paths';

const coachingServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: '12-Month High Performance Executive Coaching Program',
  provider: {
    '@type': 'Person',
    name: 'Miriam Schmidberger',
    jobTitle: 'Change Angel & Executive Performance Coach',
  },
  description: 'A tailored 12-month coaching partnership for senior executives and founders to transition from reactive firefighting to calm, grounded, high-leverage effectiveness.',
  areaServed: 'Worldwide',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Coaching Packages',
    itemListElement: [
      {
        '@type': 'Offer',
        name: 'Core 12-Month Program',
        price: '4700',
        priceCurrency: 'EUR',
        description: 'Includes 12x 60-min strategic sessions, 12x 30-min practical sessions, and two diagnostic assessments.',
      },
      {
        '@type': 'Offer',
        name: 'Executive Retainer Tier (with Asynchronous WhatsApp Support)',
        price: '8060',
        priceCurrency: 'EUR',
        description: 'Core program plus €280/month for dedicated Mon-Thu real-time WhatsApp audio/text advisory.',
      },
    ],
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much time does this program demand per week?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The program requires one 60-minute strategic session and one 30-minute practical implementation session each month. Rather than adding to your workload, the Pareto 80/20 framework routinely frees up 5 to 10 hours of wasted operational firefighting each week.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can my employer fund or sponsor my coaching?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Many clients have their 12-month program covered via corporate leadership training or executive development budgets. Official VAT invoices are issued by Turtle Transformation Limited (Ireland).',
      },
    },
    {
      '@type': 'Question',
      name: 'What occurs during the initial Discovery Call?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The 30-minute discovery call is a confidential, zero-pressure diagnostic conversation conducted over video. We explore your leadership stressors, team dynamics, and evaluate mutual fit.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are sessions conducted virtually or in person?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Delivery is hybrid. The majority of sessions take place over private video conferencing worldwide. Clients are also welcome to arrange in-person VIP immersion days in County Kerry, Ireland.',
      },
    },
  ],
};
---

<Layout 
  title="12-Month Executive Coaching with Miriam Schmidberger | Turtle Transformation"
  description="A bespoke 12-month leadership coaching program helping senior executives and founders transition from reactive overwork to calm, intentional effectiveness."
  jsonLd={[coachingServiceSchema, faqSchema]}
>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28 bg-gradient-to-b from-sand-100/70 via-sand-50 to-sand-50">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(45rem_50rem_at_top,theme(colors.turtle.100),transparent)] opacity-40"></div>
    
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Pre-header Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-turtle-100/90 border border-turtle-300 text-turtle-900 text-xs sm:text-sm font-medium mb-8 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-turtle-600"></span>
        <span>The Authentic Leader Academy • 12-Month Executive Partnership</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-turtle-950 leading-[1.18] sm:leading-[1.15] text-balance mb-6">
        Shift from Reactive Firefighting to <span class="text-turtle-700 italic font-normal">Calm, High-Impact</span> Leadership.
      </h1>

      <!-- Subheadline -->
      <p class="max-w-3xl mx-auto text-base sm:text-lg lg:text-xl text-sand-700 leading-relaxed text-balance mb-10">
        A tailored 12-month coaching partnership with <strong class="text-turtle-900 font-semibold">Miriam Schmidberger</strong> for senior directors, C-suite executives, and high-performing founders. Decouple high-stakes pressure from physiological panic, establish unshakeable boundaries, and achieve effortless strategic leverage.
      </p>

      <!-- Primary Action CTAs (Direct to Email) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 mb-14">
        <a 
          href="mailto:info@turtletrafo.de?subject=12-Month%20Coaching%20Application%20-%20Discovery%20Call" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-semibold text-white bg-turtle-800 hover:bg-turtle-900 active:bg-turtle-950 shadow-md hover:shadow-lg transition-all focus:outline-none focus:ring-2 focus:ring-turtle-600 focus:ring-offset-2 min-h-[52px]"
        >
          <svg class="w-5 h-5 text-turtle-200" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Apply via Email: info@turtletrafo.de</span>
        </a>
        <a 
          href="#program" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-semibold text-turtle-900 bg-sand-200/80 hover:bg-sand-200 active:bg-sand-300 transition-all border border-sand-300 min-h-[52px]"
        >
          Explore Program Framework
        </a>
      </div>

      <!-- Quick Contact Note -->
      <p class="text-xs text-sand-600 -mt-8 mb-12">
        Confidential direct contact: <a href="mailto:info@turtletrafo.de" class="font-semibold text-turtle-800 underline underline-offset-2">info@turtletrafo.de</a> • Response within 24 business hours
      </p>

      <!-- Credentials & Trust Bar -->
      <div class="pt-8 border-t border-sand-300/80 grid grid-cols-2 md:grid-cols-4 gap-6 text-left">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-turtle-900 font-serif">20+ Years</span>
          <span class="text-xs text-sand-600 uppercase tracking-wider font-medium">Leadership Mastery</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-turtle-900 font-serif">AQai Certified</span>
          <span class="text-xs text-sand-600 uppercase tracking-wider font-medium">Adaptability Coach</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-turtle-900 font-serif">Unbeatable Mind</span>
          <span class="text-xs text-sand-600 uppercase tracking-wider font-medium">& Heroic Certified</span>
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-turtle-900 font-serif">Greator 2024</span>
          <span class="text-xs text-sand-600 uppercase tracking-wider font-medium">Keynote Speaker</span>
        </div>
      </div>

    </div>
  </section>

  <!-- The Executive Paradox: The Shift -->
  <section class="py-20 bg-white border-y border-sand-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs uppercase font-bold tracking-widest text-turtle-600">The Shift in Leadership</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-turtle-950 mt-2 mb-4">
          Why Traditional Executive Coaching Fails Under Pressure
        </h2>
        <p class="text-sand-700 leading-relaxed text-sm sm:text-base">
          Most coaching treats leadership as an intellectual exercise in calendars and KPIs. But when high-stakes organizational crises strike, cognitive frameworks collapse. Real leadership transformation begins with nervous system regulation, emotional digestion, and deep self-trust.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        
        <!-- The Overworked State -->
        <div class="p-8 sm:p-10 rounded-2xl bg-sand-100/60 border border-sand-300 relative">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-800 text-xs font-semibold mb-6">
            <span>The Reactive Overwork Trap</span>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-turtle-950 mb-4">
            Managing from Fear & Chronic Overload
          </h3>
          <ul class="space-y-4 text-sm sm:text-base text-sand-800">
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-lg leading-none mt-0.5">✕</span>
              <span><strong>Operational Firefighting:</strong> Consumed by urgent escalations and systemic overtime, leaving zero space for strategy.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-lg leading-none mt-0.5">✕</span>
              <span><strong>Physiological Shutdowns:</strong> Severe crisis incidents trigger fight-or-flight panic, tunnel vision, or paralysis.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-lg leading-none mt-0.5">✕</span>
              <span><strong>Porous Boundaries:</strong> Sacrificing health, sleep, and family presence due to unwritten workplace expectations.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-500 font-bold text-lg leading-none mt-0.5">✕</span>
              <span><strong>Micromanagement Bottlenecks:</strong> Lack of deep team trust creates dependency, high employee turnover, and burnout.</span>
            </li>
          </ul>
        </div>

        <!-- The Grounded State -->
        <div class="p-8 sm:p-10 rounded-2xl bg-turtle-950 text-sand-100 border border-turtle-800 relative shadow-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-turtle-800 text-turtle-200 text-xs font-semibold mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>The 12-Month Transformation</span>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mb-4">
            The Grounded Authentic Leader
          </h3>
          <ul class="space-y-4 text-sm sm:text-base text-sand-200">
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-lg leading-none mt-0.5">✓</span>
              <span><strong>Pareto 80/20 Leverage:</strong> Focusing relentlessly on the 20% of strategic initiatives that deliver 80% of business outcomes.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-lg leading-none mt-0.5">✓</span>
              <span><strong>Emotional Self-Regulation:</strong> Active emotional digestion replacing panic with anchored, unflappable executive composure.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-lg leading-none mt-0.5">✓</span>
              <span><strong>Contractual Integrity:</strong> Unshakeable boundaries that protect your energy and elevate long-term executive stamina.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-400 font-bold text-lg leading-none mt-0.5">✓</span>
              <span><strong>Autonomous Excellence:</strong> Cultivating psychological safety, empowering teams to operate autonomously with zero fear.</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Core Principle Callout -->
      <div class="mt-12 p-6 rounded-xl bg-turtle-50 border border-turtle-200 text-center max-w-2xl mx-auto">
        <p class="font-serif italic text-turtle-900 text-lg">
          &ldquo;Slow is smooth, and smooth is fast. When you cultivate inner stillness, your speed of high-stakes decision making accelerates dramatically.&rdquo;
        </p>
      </div>

    </div>
  </section>

  <!-- Program Architecture (V2 Specifications) -->
  <section id="program" class="py-24 bg-sand-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs uppercase font-bold tracking-widest text-turtle-600">Comprehensive Curriculum</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-turtle-950 mt-2 mb-4">
          The 12-Month Executive Architecture
        </h2>
        <p class="text-sand-700 leading-relaxed">
          A phased, systematic methodology that transforms both your internal neuro-emotional state and your outward leadership impact.
        </p>
      </div>

      <!-- Preparatory Phase -->
      <div class="mb-12 p-8 rounded-2xl bg-white border border-sand-300 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-sand-200">
          <div>
            <span class="inline-flex px-3 py-1 rounded bg-turtle-100 text-turtle-900 text-xs font-bold uppercase tracking-wider mb-2">Phase 0: Diagnostic Baseline</span>
            <h3 class="font-serif text-2xl font-bold text-turtle-950">Preparatory Assessments Before Kickoff</h3>
            <p class="text-sm text-sand-600 mt-1">Establishing concrete metrics, behavioral blind spots, and growth tracks.</p>
          </div>
          <div class="text-sm font-semibold text-turtle-800 bg-turtle-50 px-4 py-2 rounded-lg border border-turtle-200 self-start">
            Weeks 1 – 2
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <div class="p-5 rounded-xl bg-sand-50 border border-sand-200">
            <h4 class="font-bold text-turtle-900 mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-turtle-600"></span>
              1. Adaptability Assessment (AQai)
            </h4>
            <p class="text-sm text-sand-700 leading-relaxed">
              Measures your Adaptability Quotient (AQ)—the vital leadership metric for navigating unscripted volatility, tech disruption, and high-frequency change without cognitive exhaustion.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-sand-50 border border-sand-200">
            <h4 class="font-bold text-turtle-900 mb-2 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-turtle-600"></span>
              2. Five-Mountain Leadership Assessment
            </h4>
            <p class="text-sm text-sand-700 leading-relaxed">
              Holistic audit evaluating five vital dimensions: Physical resilience, Mental clarity, Emotional agility, Strategic intuition, and Integrated execution (Kokoro / warrior heart).
            </p>
          </div>
        </div>
      </div>

      <!-- Four Core Pillars Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        
        <!-- Pillar 1 -->
        <div class="p-8 rounded-2xl bg-white border border-sand-300 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-turtle-100 text-turtle-800 font-serif font-bold text-lg flex items-center justify-center mb-6">
            01
          </div>
          <h3 class="font-serif text-xl font-bold text-turtle-950 mb-3">
            Cognitive Restructuring & Behavioral Habits
          </h3>
          <p class="text-sand-700 text-sm leading-relaxed mb-4">
            Identify and dismantle subconscious drivers, habitual procrastination loops, and automatic reaction patterns under high corporate pressure.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Dismantling childhood-inherited "rule-based" compliance</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Replacing over-functioning with deliberate strategic prioritization</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 2 -->
        <div class="p-8 rounded-2xl bg-white border border-sand-300 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-turtle-100 text-turtle-800 font-serif font-bold text-lg flex items-center justify-center mb-6">
            02
          </div>
          <h3 class="font-serif text-xl font-bold text-turtle-950 mb-3">
            Somatic Stress Regulation & Emotional Digestion
          </h3>
          <p class="text-sand-700 text-sm leading-relaxed mb-4">
            Decouple acute business triggers from physiological stress responses (cortisol/adrenaline spikes) using Parts Work, IFS principles, and embodied somatic tools.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Processing panic and despair safely without shutting down</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Reclaiming cognitive clarity in high-stakes board or investor meetings</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 3 -->
        <div class="p-8 rounded-2xl bg-white border border-sand-300 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-turtle-100 text-turtle-800 font-serif font-bold text-lg flex items-center justify-center mb-6">
            03
          </div>
          <h3 class="font-serif text-xl font-bold text-turtle-950 mb-3">
            High-Impact Dialogue & Boundary Assertion
          </h3>
          <p class="text-sand-700 text-sm leading-relaxed mb-4">
            Master non-violent communication (NVC) and structured boundary negotiation to eliminate passive-aggressive friction and navigate stakeholder politics.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Mastering the 3 Structured Reflection Questions for boundary defense</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Speaking truth without defensive withholding or fear of backlash</span>
            </li>
          </ul>
        </div>

        <!-- Pillar 4 -->
        <div class="p-8 rounded-2xl bg-white border border-sand-300 shadow-sm hover:shadow-md transition-shadow">
          <div class="w-10 h-10 rounded-lg bg-turtle-100 text-turtle-800 font-serif font-bold text-lg flex items-center justify-center mb-6">
            04
          </div>
          <h3 class="font-serif text-xl font-bold text-turtle-950 mb-3">
            Team Performance & Psychological Safety
          </h3>
          <p class="text-sand-700 text-sm leading-relaxed mb-4">
            Transition from control-oriented management to cultivating an autonomous, high-retention engineering/business culture through enhanced empathy and trust.
          </p>
          <ul class="text-xs text-sand-600 space-y-2">
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Non-punitive mistake analysis that accelerates team velocity</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-turtle-600">•</span>
              <span>Proven track record: Drastic reduction in employee sick days & turnover</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Program Delivery & Cadence Details -->
      <div class="p-8 sm:p-10 rounded-2xl bg-turtle-900 text-sand-100">
        <h3 class="font-serif text-2xl font-bold text-white mb-6 text-center">
          Program Structure & Logistics
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
          
          <div class="space-y-2">
            <span class="text-turtle-300 font-semibold text-sm uppercase tracking-wider">Duration</span>
            <p class="text-xl font-bold text-white">12 Full Months</p>
            <p class="text-xs text-sand-300 leading-relaxed">
              Deep, sustainable habit integration ensuring complete leadership self-sufficiency and independence by month 12.
            </p>
          </div>

          <div class="space-y-2">
            <span class="text-turtle-300 font-semibold text-sm uppercase tracking-wider">Monthly Cadence</span>
            <p class="text-xl font-bold text-white">2 Dedicated Sessions</p>
            <p class="text-xs text-sand-300 leading-relaxed">
              1x 60-min Strategic Deep-Dive (thematic & emotional realignment) plus 1x 30-min Practical Operational Implementation session.
            </p>
          </div>

          <div class="space-y-2">
            <span class="text-turtle-300 font-semibold text-sm uppercase tracking-wider">Delivery Format</span>
            <p class="text-xl font-bold text-white">Hybrid Flexibility</p>
            <p class="text-xs text-sand-300 leading-relaxed">
              Available via high-definition virtual video conferencing or in-person VIP immersion sessions in Kerry, Ireland / Europe.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Investment & Commitment Section -->
  <section class="py-20 bg-white border-b border-sand-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-12">
        <span class="text-xs uppercase font-bold tracking-widest text-turtle-600">Transparent Pricing</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-turtle-950 mt-2 mb-4">
          Investment & Partnership Options
        </h2>
        <p class="text-sand-700">
          Structured for tangible personal ROI, sustainable energy, and organizational velocity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        <!-- Base Package -->
        <div class="p-8 rounded-2xl bg-sand-50 border-2 border-sand-300 flex flex-col justify-between">
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-sand-600">Core Executive Partnership</span>
            <h3 class="font-serif text-2xl font-bold text-turtle-950 mt-1 mb-2">12-Month Coaching Program</h3>
            <div class="my-4">
              <span class="text-4xl font-bold text-turtle-900 font-serif">€4,700</span>
              <span class="text-sand-600 text-sm"> / full year</span>
            </div>
            <p class="text-xs text-sand-600 mb-6">
              Structured in two installments of €2,350 with a formal 6-month progress audit.
            </p>
            <ul class="space-y-3 text-sm text-sand-800 border-t border-sand-200 pt-6">
              <li class="flex items-center gap-2">
                <span class="text-turtle-600 font-bold">✓</span>
                <span>Both Baseline Assessments (AQai & Five-Mountain)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-600 font-bold">✓</span>
                <span>12x 60-min Strategic Coaching Sessions</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-600 font-bold">✓</span>
                <span>12x 30-min Practical Application Sessions</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-600 font-bold">✓</span>
                <span>Custom exercises & reading assignments</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-turtle-600 font-bold">✓</span>
                <span>Corporate invoice provided for employer sponsorship</span>
              </li>
            </ul>
          </div>
          <div class="mt-8 pt-6 border-t border-sand-200">
            <a 
              href="mailto:info@turtletrafo.de?subject=Application%20-%2012-Month%20Coaching%20Program%20(Core)" 
              class="w-full inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-semibold text-turtle-900 bg-sand-200 hover:bg-sand-300 transition-colors min-h-[48px]"
            >
              Apply via Email: info@turtletrafo.de
            </a>
          </div>
        </div>

        <!-- Premium Package with Asynchronous WhatsApp -->
        <div class="p-8 rounded-2xl bg-turtle-950 text-sand-100 border-2 border-turtle-700 flex flex-col justify-between relative shadow-xl">
          <div class="absolute -top-3 right-6 bg-accent text-turtle-950 text-[11px] uppercase tracking-wider font-bold py-1 px-3 rounded-full shadow">
            Recommended for Active Executives
          </div>
          <div>
            <span class="text-xs uppercase font-bold tracking-wider text-turtle-300">Executive Retainer + Real-Time Access</span>
