---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import { getRelativePath } from '../utils/paths';
---

<Layout
  title="Page Not Found (404) | Turtle Transformation"
  description="The requested page could not be found."
>

  <section class="py-32 bg-sand-50 text-center">
    <div class="max-w-md mx-auto px-4">
      <div class="font-serif text-5xl text-turtle-800 mb-4 font-normal">
        404
      </div>
      <h1 class="font-serif text-3xl font-normal text-turtle-950 mb-3 tracking-tight">
        Page Not Found
      </h1>
      <p class="text-sm text-sand-700 mb-8 leading-relaxed">
        The page you are looking for has been moved or updated as part of our simplified website release.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href={getRelativePath('/')} 
          class="w-full sm:w-auto px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-semibold text-white bg-turtle-900 hover:bg-turtle-800 transition-colors"
        >
          Return to 12-Month Coaching
        </a>
        <a 
          href={getRelativePath('/data-ai-consulting')} 
          class="w-full sm:w-auto px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-semibold text-turtle-900 bg-sand-200 hover:bg-sand-300 transition-colors"
        >
          Data & AI Advisory
        </a>
      </div>
    </div>
  </section>

</Layout>
