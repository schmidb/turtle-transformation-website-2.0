---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import { getRelativePath } from '../utils/paths';
---

<Layout
  title="Page Not Found (404) | Turtle Transformation"
  description="The requested page could not be found."
>

  <section class="py-28 bg-sand-50 text-center">
    <div class="max-w-md mx-auto px-4">
      <div class="w-16 h-16 rounded-2xl bg-turtle-100 text-turtle-800 flex items-center justify-center mx-auto mb-6 font-serif text-2xl font-bold">
        404
      </div>
      <h1 class="font-serif text-3xl font-bold text-turtle-950 mb-3">
        Page Not Found
      </h1>
      <p class="text-sm text-sand-700 mb-8 leading-relaxed">
        The page you are looking for has been moved or updated as part of our simplified website release.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href={getRelativePath('/')} 
          class="w-full sm:w-auto px-6 py-3 rounded-xl text-sm font-semibold text-white bg-turtle-800 hover:bg-turtle-900 transition-colors"
        >
          Return to 12-Month Coaching
        </a>
        <a 
          href={getRelativePath('/data-ai-consulting')} 
          class="w-full sm:w-auto px-6 py-3 rounded-xl text-sm font-semibold text-turtle-900 bg-sand-200 hover:bg-sand-300 transition-colors"
        >
          Data & AI Consulting
        </a>
      </div>
    </div>
  </section>

</Layout>
