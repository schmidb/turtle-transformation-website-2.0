---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { getRelativePath } from '../utils/paths';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Our 20-Year Journey | Miriam & Dr. Markus Schmidberger',
  description: 'The story behind Turtle Transformation: How Miriam and Dr. Markus Schmidberger united deep somatic transformation with high-stakes executive data leadership.',
  mainEntity: [
    {
      '@type': 'Person',
      name: 'Miriam Schmidberger',
      jobTitle: 'Co-Founder, Executive Performance Coach & Industry AI Advisor',
      affiliation: 'Munster Technological University (MTU) Kerry',
      description: 'Industry AI Advisor for Munster Technological University (MTU) Kerry, Certified AQai Adaptability Coach, Unbeatable Mind & Heroic Certified Coach, Yoga Alliance Master Teacher, and Greator Festival 2024 Keynote Speaker.',
    },
    {
      '@type': 'Person',
      name: 'Dr. Markus Schmidberger',
      jobTitle: 'Co-Founder & Enterprise Data/AI Strategist',
      description: 'PhD in Bioinformatics/Mathematics, former Director of Data at Scout24 Group, AWS ProServe Senior Consultant, and certified Life Trust Coach.',
    },
  ],
};
---

<Layout
  title="Our 20-Year Journey | Miriam & Dr. Markus Schmidberger | Turtle Transformation"
  description="Discover the 20-year story of Turtle Transformation: uniting executive data leadership and agile scaling with somatic emotional regulation and deep personal growth."
  jsonLd={aboutPageSchema}
>

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-16 pb-24 lg:pt-24 lg:pb-32 bg-gradient-to-b from-sand-100/50 via-sand-50 to-sand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <!-- Pre-header Label -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sand-200/70 text-turtle-900 text-xs font-semibold tracking-wider uppercase mb-8">
        <span>The Founders</span>
        <span>•</span>
        <span>2006 to 2026</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-turtle-950 leading-[1.15] text-balance mb-6">
        Two Decades of Leadership, <span class="italic font-normal text-turtle-800">Transformation, & Truth.</span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg lg:text-xl text-sand-700 leading-relaxed text-balance mb-10 font-normal">
        How a high-stakes corporate data executive and a deep somatic performance coach forged an unshakeable philosophy: that lasting outward leadership impact is only possible when you master inner stillness.
      </p>

      <div class="inline-flex items-center gap-4 text-xs text-sand-600 border-t border-b border-sand-200/80 py-3 px-6">
        <span>Founded in Kerry, Ireland</span>
        <span>•</span>
        <span>Empowering 1,000,000 Leaders</span>
        <span>•</span>
        <span>The Authentic Leader Academy</span>
      </div>

    </div>
  </section>

  <!-- The Philosophy of the Turtle -->
  <section class="py-24 bg-white border-y border-sand-200/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">Core Principles</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-turtle-950 mt-2 mb-4 tracking-tight">
          Why the Turtle?
        </h2>
        <p class="text-sand-700 leading-relaxed text-sm sm:text-base">
          In an executive world addicted to frantic reactivity, the turtle represents timeless wisdom, steady resilience, and unshakeable inner calm.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="p-8 sm:p-10 rounded-2xl bg-sand-50/70 border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">01</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Slow is Smooth, Smooth is Fast
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed">
            Rushing creates tunnel vision, relational collateral damage, and costly operational blunders. When leaders pause to digest emotions and establish inner clarity, their speed of high-stakes execution accelerates dramatically.
          </p>
        </div>

        <div class="p-8 sm:p-10 rounded-2xl bg-sand-50/70 border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">02</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Carrying Your Shelter Within
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed">
            The turtle carries its home everywhere. True leaders do not depend on external validation, titles, or market stability for emotional safety. They cultivate unshakeable self-worth from the inside out.
          </p>
        </div>

        <div class="p-8 sm:p-10 rounded-2xl bg-sand-50/70 border border-sand-200/80 shadow-sm">
          <div class="font-serif text-2xl text-sand-400 mb-4">03</div>
          <h3 class="font-serif text-xl font-normal text-turtle-950 mb-3">
            Land and Ocean Fluency
          </h3>
          <p class="text-sand-700 text-xs sm:text-sm leading-relaxed">
            Thriving both on grounded earth (structure, KPIs, technical architecture) and in deep waters (emotional complexity, psychological safety, intuition). We bridge both worlds without compromise.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- The 20-Year Evolution Timeline (2006–2026) -->
  <section class="py-24 bg-sand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">The Journey</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-normal text-turtle-950 mt-2 mb-4 tracking-tight">
          20 Years in the Making
        </h2>
        <p class="text-sand-700 text-sm sm:text-base">
          Our coaching and advisory methodologies were forged in the crucible of real corporate high-stakes leadership, academic boundaries, and continuous personal growth.
        </p>
      </div>

      <div class="space-y-12 relative before:absolute before:inset-0 before:left-8 md:before:left-1/2 before:-ml-px before:w-px before:bg-sand-300">
        
        <!-- Timeline Item 1 -->
        <div class="relative flex flex-col md:flex-row items-start group">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-turtle-900 text-white font-serif text-xs absolute left-4 md:left-1/2 -translate-x-1/2 z-10 shadow-sm">
            1
          </div>
          <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
            <span class="text-xs font-semibold uppercase tracking-wider text-turtle-700">2006 – 2011</span>
            <h3 class="font-serif text-xl font-normal text-turtle-950 mt-1 mb-2">Boundaries & Academic Pressure</h3>
            <p class="text-xs sm:text-sm text-sand-700 leading-relaxed">
              Completing his Technical Mathematics diploma and PhD in Bioinformatics, Markus faced intense academic pressures to donate 20 unpaid hours weekly. With Miriam's coaching on structured reflection questions, he learned to assert legal boundaries while satisfying professors—discovering the power of contractual agency.
            </p>
          </div>
          <div class="hidden md:block md:w-1/2"></div>
        </div>

        <!-- Timeline Item 2 -->
        <div class="relative flex flex-col md:flex-row items-start group">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-turtle-900 text-white font-serif text-xs absolute left-4 md:left-1/2 -translate-x-1/2 z-10 shadow-sm">
            2
          </div>
          <div class="hidden md:block md:w-1/2"></div>
          <div class="ml-16 md:ml-0 md:w-1/2 md:pl-12">
            <span class="text-xs font-semibold uppercase tracking-wider text-turtle-700">2011 – 2014</span>
            <h3 class="font-serif text-xl font-normal text-turtle-950 mt-1 mb-2">Fatherhood, Marriage & The Big Data Shift</h3>
            <p class="text-xs sm:text-sm text-sand-700 leading-relaxed">
              Balancing fatherhood, modern marriage dynamics, and the transition into cloud and big data engineering. Through deep intentional relationship work and counseling, Miriam and Markus developed the communication tools that now anchor their coaching framework.
            </p>
          </div>
        </div>

        <!-- Timeline Item 3 -->
        <div class="relative flex flex-col md:flex-row items-start group">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-turtle-900 text-white font-serif text-xs absolute left-4 md:left-1/2 -translate-x-1/2 z-10 shadow-sm">
            3
          </div>
          <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
            <span class="text-xs font-semibold uppercase tracking-wider text-turtle-700">2014 – 2020</span>
            <h3 class="font-serif text-xl font-normal text-turtle-950 mt-1 mb-2">AWS ProServe & Scaling Scout24 to 50+ Engineers</h3>
            <p class="text-xs sm:text-sm text-sand-700 leading-relaxed">
              Markus served as Senior Consultant at AWS and subsequently Director of Data at Scout24 Group. Scaling the data organization from 15 to 50+ engineers across multiple hubs, Miriam coached him to handle major live production data incidents with zero panic. Together they proved that psychological safety dramatically reduces employee turnover and sick days while multiplying output.
            </p>
          </div>
          <div class="hidden md:block md:w-1/2"></div>
        </div>

        <!-- Timeline Item 4 -->
        <div class="relative flex flex-col md:flex-row items-start group">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-turtle-900 text-white font-serif text-xs absolute left-4 md:left-1/2 -translate-x-1/2 z-10 shadow-sm">
            4
          </div>
          <div class="hidden md:block md:w-1/2"></div>
          <div class="ml-16 md:ml-0 md:w-1/2 md:pl-12">
            <span class="text-xs font-semibold uppercase tracking-wider text-turtle-700">2021 – 2026</span>
            <h3 class="font-serif text-xl font-normal text-turtle-950 mt-1 mb-2">The Authentic Leader Academy & Global Reach</h3>
            <p class="text-xs sm:text-sm text-sand-700 leading-relaxed">
              Relocating their family to the rugged Atlantic coast of Kerry, Ireland, they formalized <strong>Turtle Transformation Limited</strong>. Miriam spoke at the Greator Festival 2024 to thousands of leaders alongside Tony Robbins. Today, they deliver their 12-month executive coaching program and lead enterprise Data & AI strategic advisory together—with Miriam serving as an Industry AI Advisor for Munster Technological University (MTU) Kerry alongside Dr. Markus's enterprise technology advisory.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Detailed Founder Bios -->
  <section class="py-24 bg-white border-t border-sand-200/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      
      <!-- Miriam Bio -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center">
        <div class="md:col-span-4">
          <div class="rounded-2xl bg-turtle-950 text-sand-100 p-8 text-center border border-turtle-900 shadow-md">
            <div class="font-serif text-3xl text-turtle-300 font-normal mb-1">Miriam</div>
            <div class="text-[11px] uppercase tracking-widest text-sand-400">Schmidberger</div>
            <p class="text-xs text-turtle-300 mt-2 font-medium">
              Change Angel & Executive Coach
            </p>
            <div class="text-xs text-sand-300 space-y-1 text-left border-t border-turtle-900 pt-4 mt-6">
              <p>• Industry AI Advisor, MTU Kerry</p>
              <p>• Keynote Speaker, Greator Festival '24</p>
              <p>• Certified AQai Coach</p>
              <p>• Unbeatable Mind & Heroic Coach</p>
            </div>
          </div>
        </div>

        <div class="md:col-span-8 space-y-4">
          <div>
            <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">Co-Founder</span>
            <h2 class="font-serif text-3xl font-normal text-turtle-950 mt-1">Miriam Schmidberger</h2>
            <p class="text-xs uppercase tracking-wider text-turtle-800 font-medium mt-0.5">
              Change Angel & Executive Coach • Industry AI Advisor (MTU Kerry)
            </p>
          </div>
          <p class="text-sand-800 text-xs sm:text-sm leading-relaxed">
            Miriam specializes in what most leadership and technology programs ignore: the nervous system, emotional digestion, and the subconscious patterns that cause leaders and organizations to resist change, over-function, or shutdown under crisis.
          </p>
          <p class="text-sand-800 text-xs sm:text-sm leading-relaxed">
            Drawing on over 20 years of continuous study in Internal Family Systems (IFS), Non-Violent Communication, somatic breathwork, and adaptability science, Miriam provides an uncompromising yet deeply compassionate sounding board. As an <strong>Industry AI Advisor for Munster Technological University (MTU) Kerry</strong>, she guides institutions and executive teams through the human, psychological, and operational adaptability required to truly succeed with AI.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row gap-4">
            <a 
              href={getRelativePath('/')} 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-turtle-900 hover:text-turtle-700 underline underline-offset-4"
            >
              <span>Miriam's 12-Month Executive Coaching</span>
              <span>→</span>
            </a>
            <a 
              href={getRelativePath('/data-ai-consulting')} 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-turtle-900 hover:text-turtle-700 underline underline-offset-4"
            >
              <span>Explore Data & AI Advisory</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Markus Bio -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-center pt-16 border-t border-sand-200/60">
        <div class="md:col-span-8 space-y-4 order-2 md:order-1">
          <div>
            <span class="text-xs uppercase font-semibold tracking-widest text-turtle-700">Co-Founder</span>
            <h2 class="font-serif text-3xl font-normal text-turtle-950 mt-1">Dr. Markus Schmidberger</h2>
            <p class="text-xs uppercase tracking-wider text-turtle-800 font-medium mt-0.5">
              Data & AI Strategist • Former Scout24 Director • PhD Bioinformatics
            </p>
          </div>
          <p class="text-sand-800 text-xs sm:text-sm leading-relaxed">
            Markus holds a PhD in Bioinformatics and Technical Mathematics. His career spans building early cloud platforms, leading big data consulting initiatives at Amazon Web Services (AWS) ProServe, and serving as Director of Data at Scout24 Group, where he scaled the engineering organization from 15 to over 50 people.
          </p>
          <p class="text-sand-800 text-xs sm:text-sm leading-relaxed">
            He combines deep technical rigor in distributed systems, modern cloud architecture, and enterprise AI with certified coaching credentials (Life Trust Coaching). Together with Miriam, Markus acts as a trusted peer sounding board for CTOs, CEOs, and investment boards seeking to turn AI theory into sustainable competitive advantage.
          </p>
          <div class="pt-2">
            <a 
              href={getRelativePath('/data-ai-consulting')} 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-turtle-900 hover:text-turtle-700 underline underline-offset-4"
            >
              <span>Explore Data & AI Advisory with Miriam & Markus</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="md:col-span-4 order-1 md:order-2">
          <div class="rounded-2xl bg-sand-50/70 text-turtle-950 p-8 text-center border border-sand-200/80 shadow-sm">
            <div class="font-serif text-3xl text-turtle-950 font-normal mb-1">Dr. Markus</div>
            <div class="text-[11px] uppercase tracking-widest text-sand-600">Schmidberger</div>
            <p class="text-xs text-turtle-800 mt-2 font-medium">
              Data & AI Strategist • Ex-Director
            </p>
            <div class="text-xs text-sand-700 space-y-1 text-left border-t border-sand-200/60 pt-4 mt-6">
              <p>• PhD in Bioinformatics & Mathematics</p>
              <p>• Ex-Director of Data at Scout24 (50+ org)</p>
              <p>• Ex-Senior Big Data Consultant at AWS</p>
              <p>• Certified Life Trust Coach</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Final Contact CTA -->
  <section class="py-24 sm:py-28 bg-turtle-950 text-sand-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-normal text-white mb-4 tracking-tight">
        Connect with Miriam & Markus
      </h2>
      <p class="text-sand-300 text-sm sm:text-base max-w-xl mx-auto mb-8 leading-relaxed">
        Whether you are seeking 1-on-1 executive coaching, team leadership culture transformation, or strategic enterprise AI advisory, reach out directly to start a conversation.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="mailto:info@turtletrafo.de?subject=General%20Inquiry%20-%20Turtle%20Transformation" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full text-xs uppercase tracking-wider font-semibold text-turtle-950 bg-sand-200 hover:bg-white active:bg-sand-300 shadow-md transition-all min-h-[50px]"
        >
          <svg class="w-4 h-4 text-turtle-900" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Email Us: info@turtletrafo.de</span>
        </a>
      </div>

      <p class="text-xs text-turtle-400 mt-8">
        Turtle Transformation Limited • Glenbeigh, Co. Kerry, Ireland • Phone: +353 87 227 5723
      </p>
    </div>
  </section>

</Layout>
